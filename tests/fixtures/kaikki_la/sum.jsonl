{"senses": [{"examples": [{"text": "Cīvis rōmānus sum.", "bold_text_offsets": [[14, 17]], "translation": "I am a Roman citizen.", "english": "I am a Roman citizen.", "bold_translation_offsets": [[0, 4]], "type": "example"}, {"text": "Sum sine rēgnō.", "bold_text_offsets": [[0, 3]], "translation": "I am without a kingdom.", "english": "I am without a kingdom.", "bold_translation_offsets": [[0, 4]], "type": "example"}, {"text": "Dīxit duās rēs eī rubōrī fuisse.", "bold_text_offsets": [[25, 31]], "translation": "He said that two things had abashed him.", "english": "He said that two things had abashed him.", "bold_translation_offsets": [[24, 27]], "type": "example"}, {"text": "Q RAVEL[I]O [Q F - - -] P COMINIO P F L MALIO C F QUAISTORES SENATU D [I R F?] CONSULERE IEI[S] CENSUERE AUT SACROM AUT POUBLICOM ESE\n- - - - - - [- - - SE]NATU CONSOLTU DE[- - -] AUT SACROM AUT POUBLIC[OM] LOCOM ESE O[MNES?- - -] CENSURE", "ref": "Gianfranco Purpura, editor (2012), “Decreta decurionum: Sulla presenza di decreta decurionum nella pars tertia, negotia, dei Fontes Iuris Romani Antejustiniani (A. Parma)”, in Revisione ed integrazione dei Fontes Iuris Romani Anteiustiniani (FIRA): Studi preparatori (Fontes; 3.1) (in Italian), volume I (Leges), Turin: G. Giappichelli Editore, →ISBN, archived from the original on 12 Aug 2026, page 225", "english": "Quintus Ravelius, [son of Quintus; - - -]; Publius Cominius, son of Publius; [and] Lucius Mallius, son of Gaius, quaestors, decreed that the Senate be consulted by them concerning [this matter to be done?], [and] that [it] be either sacred or public.\n- - - - - - [- - -] by decree of the Senate concerning [- - -] that the place be either sacred or public, [all?- - -] decreed.", "type": "quotation", "bold_text_offsets": [[130, 133], [213, 216]], "translation": "Quintus Ravelius, [son of Quintus; - - -]; Publius Cominius, son of Publius; [and] Lucius Mallius, son of Gaius, quaestors, decreed that the Senate be consulted by them concerning [this matter to be done?], [and] that [it] be either sacred or public.\n- - - - - - [- - -] by decree of the Senate concerning [- - -] that the place be either sacred or public, [all?- - -] decreed.", "bold_translation_offsets": [[148, 150], [196, 198], [223, 225], [329, 331]]}, {"text": "Homō sum, hūmānī nihil ā mē aliēnum putō.", "ref": "163 BCE, Publius Terentius Afer, Heauton Timorumenos 1.77", "english": "I am a man, I consider nothing that is human alien to me.", "translation": "I am a man, I consider nothing that is human alien to me.", "type": "quotation"}, {"text": "Ō dī immortālēs, ubinam gentium sumus?", "ref": "63 BCE, Cicero, In Catilinam orationes 1.9", "english": "O ye immortal gods, where on earth are we?", "translation": "O ye immortal gods, where on earth are we?", "type": "quotation"}, {"text": "Mēcum erit iste labor. [...]", "ref": "29 BCE – 19 BCE, Vergilius, Aeneis 4.115", "english": "That task will be mine. …", "translation": "That task will be mine. …", "type": "quotation"}, {"text": "Alea iacta est.", "ref": "121 CE, Suetonius, De Vita Caesarum, Iulius 33:", "english": "The die is cast.", "type": "quotation", "bold_text_offsets": [[11, 14]], "translation": "The die is cast.", "bold_translation_offsets": [[8, 10]]}, {"text": "Honōrā patrem tuum et matrem tuam, ut sīs longaevus super terram, quam Dominus Deus tuus dabit tibi.", "ref": "c. 347 CE – 420 CE, Hieronymus, Vulgate Exodus 20:12", "english": "Honour thy father and thy mother, that thou mayest be longlived upon the land which the Lord thy God will give thee.", "translation": "Honour thy father and thy mother, that thou mayest be longlived upon the land which the Lord thy God will give thee.", "type": "quotation"}, {"text": "Cogito, ergo sum.", "ref": "1647, René Descartes, Meditationes de Prima Philosophia, in qua Dei existentia et animæ immortalitas demonstratur:", "english": "I think, therefore I am.", "type": "quotation", "bold_text_offsets": [[13, 16]], "translation": "I think, therefore I am.", "bold_translation_offsets": [[19, 23]]}], "categories": ["Latin copulative verbs", "Latin terms with quotations", "Latin terms with usage examples"], "links": [["be", "be"], ["exist", "exist"]], "raw_glosses": ["(copulative) to be, exist"], "glosses": ["to be, exist"], "tags": ["copulative", "suppletive"]}, {"examples": [{"text": "Mihī est multum tempus.", "bold_text_offsets": [[5, 8]], "translation": "I have a lot of time.", "english": "I have a lot of time.", "bold_translation_offsets": [[2, 6]], "literal_meaning": "A lot of time is to me.", "bold_literal_offsets": [[14, 16]], "type": "example"}, {"text": "misera excrucior, mea Gymnasium: male mihi est, male maceror", "ref": "c. 203 BCE, Plautus, Cistellaria 59", "english": "I'm pitiful and being tortured, my dear Gymnasius: I feel terrible, and I'm being tormented in a bad way\n(literally, “I am miserable and being tortured, my Gymnasius, poorly is to me, I'm being tormented in a bad way”)", "translation": "I'm pitiful and being tortured, my dear Gymnasius: I feel terrible, and I'm being tormented in a bad way\n(literally, “I am miserable and being tortured, my Gymnasius, poorly is to me, I'm being tormented in a bad way”)", "type": "quotation"}], "categories": ["Latin copulative verbs", "Latin terms with quotations", "Latin terms with usage examples"], "links": [["be", "be"], ["exist", "exist"], ["belong", "belong"]], "raw_glosses": ["(copulative) to be, exist", "to belong [with dative]"], "glosses": ["to be, exist", "to belong"], "info_templates": [{"args": {"1": "la", "2": "dat"}, "name": "+obj", "extra_data": {"tags": ["dative"]}, "expansion": "[with dative]"}], "tags": ["copulative", "suppletive"]}, {"examples": [{"text": "Estne adhūc aliquid malī", "ref": "c. 4 BCE – 65 CE, Seneca Minor, Hercules Oetaeus 1399–1400", "english": "Is there still anything bad\nwith me in the world?", "translation": "Is there still anything bad\nwith me in the world?", "type": "quotation", "roman": "in orbe mēcum?"}], "links": [["existential", "existential"], ["there be", "there be"]], "categories": ["Latin terms with quotations"], "raw_glosses": ["(existential) there be"], "qualifier": "existential", "glosses": ["there be"], "tags": ["suppletive"]}, {"examples": [{"text": "Ad quod caſtrum vincendum Piſani fuerunt cum quinquaginta navibus, plattis, & ſchafis, […]", "ref": "1371, Michaël de Vico, “Breviarium Pisanæ Historiæ: Auctius & Emendatius Nunc Primùm Prodit ex MSto Lucensi”, in Ludovicus Antonius Muratorius, editor, Rerum Italicarum Scriptores […], Milan: Ex typographia Societatis Palatinæ in Regia Curia, published 1725, →OCLC, column 171:", "english": "They went to conquer Pisanius' castle with fifty boats, engines, and siege weapons, […]", "type": "quotation", "bold_text_offsets": [[33, 40]], "translation": "They went to conquer Pisanius' castle with fifty boats, engines, and siege weapons, […]", "bold_translation_offsets": [[0, 9]]}], "categories": ["Latin terms with quotations", "Medieval Latin"], "links": [["go", "go"]], "raw_glosses": ["(Medieval Latin, in the past tense) to go"], "glosses": ["to go"], "tags": ["Medieval-Latin", "past", "suppletive"]}, {"examples": [{"text": "Audīte disciplīnam et estōte sapientēs et nōlīte abicere eam.", "ref": "c. 347 CE – 420 CE, Hieronymus, Vulgate Proverbs 8:33", "english": "Hear instruction and be wise, and refuse it not.", "translation": "Hear instruction and be wise, and refuse it not.", "type": "quotation"}], "categories": ["Ecclesiastical Latin", "Late Latin", "Latin terms with quotations"], "links": [["be", "be"]], "raw_glosses": ["(Late Latin, Ecclesiastical Latin, imperative) be"], "glosses": ["be"], "tags": ["Ecclesiastical", "Late-Latin", "Latin", "imperative", "suppletive"]}], "pos": "verb", "head_templates": [{"name": "la-verb", "args": {"1": "irreg", "2": "sum"}, "expansion": "sum (present infinitive esse, perfect active fuī, future active participle futūrus); irregular conjugation, suppletive, no passive, no supine