__pycache__/
*.pyc
.venv/
dist/
*.egg-info/
.DS_Store
results/*.xlsx
cache/
logs/
.worktrees/
pwa/tests/parity_fixture.json
pwa/node_modules/
data/decks/
# Index scans of Art: The Definitive Visual Guide (~58MB); OCR text under ocr/ stays tracked
data/art_definitive_index/*.jpeg

# Extracted paper text for MCQ decks — third-party copyrighted full text, kept local.
# `deck-papers build` verifies every card's quote against it, so a fresh clone cannot
# build a paper deck until the source text is re-extracted.
configs/papers/*.source.txt

# Scene images: review sheets and batch state are rebuildable/transient; the images themselves are tracked.
results/generate_scene_images/**/contact_sheet.png
results/generate_scene_images/**/compare_*.png
results/generate_scene_images/_batches/
