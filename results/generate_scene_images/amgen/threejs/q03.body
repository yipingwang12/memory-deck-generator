// q03 — The GENIE lives among a THOUSAND OAK trees in California.
import { THREE, run, mat, add, blob, panel, oak, rng } from './common.js';
run({
  ground: '#c4b45e', frame: { x: 0, y: 1.9, H: 5.0 },
  genie: { x: 1.0, z: 0.8, scale: 1.4, ry: 0.2 },
  build({ scene }) {
    const r = rng(11);
    for (const [x, z, s] of [[-14, -24, 7], [12, -26, 8], [0, -30, 9]]) blob(scene, mat('#d9c36a'), [x, -0.5, z], [s * 2.2, s * 0.9, s * 1.4]);
    for (let i = 0; i < 44; i++) {
      const x = (r() - 0.5) * 20, z = -1.5 - r() * 14; if (Math.abs(x - 0.9) < 1.3 && z > -3.5) continue;
      const o = oak(0.7 + r() * 0.4, i + 1); o.position.set(x, 0, z); scene.add(o);
    }
    const big = oak(1.7, 40); big.position.set(3.4, 0, -2.5); scene.add(big);
    const big2 = oak(1.3, 41); big2.position.set(-4.4, 0, -0.8); scene.add(big2);
    for (let i = 0; i < 90; i++) blob(scene, mat('#ff8a1e'), [(r() - 0.5) * 12, 0.05, -0.5 + r() * 3.5], [0.07, 0.04, 0.07]);
    const s = panel(1.7, 1.1, ['1000', 'OAKS'], { bg: '#fff6dc', border: '#7a4a22', colors: ['#d8362e', '#2a6a2a'] }); s.position.set(-2.4, 1.3, 1.2); s.rotation.y = 0.3; scene.add(s);
    add(scene, new THREE.CylinderGeometry(0.07, 0.07, 1.4, 10), mat('#7a4a22'), [-2.4, 0.6, 1.15]);
  },
});
