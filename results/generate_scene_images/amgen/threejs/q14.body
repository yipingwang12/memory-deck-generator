// q14 — The GENIE agrees to swallow a CHEMO CENTRE marked with an X (ChemoCentryx).
import { THREE, run, mat, add, blob, panel } from './common.js';
function clinic() {
  const g = new THREE.Group();
  add(g, new THREE.BoxGeometry(3.2, 2.6, 1.8), mat('#f4f6fa'), [0, 1.3, 0]);
  add(g, new THREE.BoxGeometry(3.4, 0.25, 2.0), mat('#2a6fd8'), [0, 2.7, 0]);
  const sign = panel(2.7, 1.0, ['CHEMO', 'CENTRE'], { bg: '#1c4fa0', fg: '#fff', border: '#e8e8e8', d: 0.12 }); sign.position.set(0, 2.0, 0.95); g.add(sign);
  for (const x of [-1.15, 1.15]) add(g, new THREE.BoxGeometry(0.6, 0.6, 0.06), mat('#9fd4f0'), [x, 0.95, 0.92]);
  add(g, new THREE.BoxGeometry(0.7, 1.0, 0.06), mat('#6a7a90'), [0, 0.5, 0.92]);
  const red = mat('#e01e2a', { roughness: 0.4 });
  for (const s of [-1, 1]) add(g, new THREE.BoxGeometry(2.3, 0.28, 0.14), red, [0, 0.85, 1.02], [0, 0, s * 0.55]);
  return g;
}
run({
  ground: '#cfc9bc', frame: { x: 0.4, y: 2.0, H: 5.2 },
  genie: { x: -2.2, z: 0.4, scale: 1.55, ry: 0.7, pose: { lean: 0.12, headTilt: 0.05, arms: { l: [0, 1.5, 0.15], r: [0.5, -0.1, 1.2] } }, mouth: 0.9 },
  build({ scene }) {
    const c = clinic(); c.position.set(2.4, 0, -0.3); c.rotation.y = -0.15; scene.add(c);
    add(scene, new THREE.BoxGeometry(60, 0.04, 4), mat('#5a5e68'), [0, 0.02, 3.6]);
  },
});
