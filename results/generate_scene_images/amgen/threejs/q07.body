// q07 — In Massachusetts, the GENIE keeps only its factory floor: operations and process development.
import { THREE, run, mat, add, blob, tex, rng } from './common.js';
const steel = () => mat('#aab6c6', { metalness: 0.55, roughness: 0.35 });
function tank(r, h) {
  const g = new THREE.Group();
  add(g, new THREE.CylinderGeometry(r, r, h, 32), steel(), [0, h / 2 + 0.5, 0]);
  blob(g, steel(), [0, h + 0.5, 0], [r, r * 0.55, r]);
  for (const y of [0.3, 0.5, 0.8].map((k) => k * h + 0.5)) add(g, new THREE.TorusGeometry(r + 0.02, 0.05, 8, 32), mat('#5a6678'), [0, y, 0], [Math.PI / 2, 0, 0]);
  for (const a of [0.8, 2.4, 4.0, 5.5]) add(g, new THREE.CylinderGeometry(0.07, 0.07, 0.55, 8), mat('#5a6678'), [Math.cos(a) * r * 0.8, 0.25, Math.sin(a) * r * 0.8]);
  add(g, new THREE.CylinderGeometry(r * 0.28, r * 0.28, 0.05, 20), mat('#5fd0ff'), [0, h * 0.62 + 0.5, r + 0.01], [Math.PI / 2, 0, 0]);
  return g;
}
function gear(R, n) {
  const g = new THREE.Group(), m = mat('#f2b82a', { metalness: 0.4, roughness: 0.4 });
  add(g, new THREE.CylinderGeometry(R, R, 0.3, 40), m, [0, 0, 0], [Math.PI / 2, 0, 0]);
  for (let i = 0; i < n; i++) { const a = i / n * Math.PI * 2; add(g, new THREE.BoxGeometry(R * 0.32, R * 0.3, 0.3), m, [Math.cos(a) * R * 1.08, Math.sin(a) * R * 1.08, 0], [0, 0, a]); }
  add(g, new THREE.CylinderGeometry(R * 0.35, R * 0.35, 0.34, 24), mat('#4a4f5c'), [0, 0, 0], [Math.PI / 2, 0, 0]);
  return g;
}
function vial(c) {
  const g = new THREE.Group();
  add(g, new THREE.CylinderGeometry(0.2, 0.2, 0.75, 20), new THREE.MeshStandardMaterial({ color: '#dff4ff', transparent: true, opacity: 0.45, roughness: 0.1 }), [0, 0.4, 0]);
  add(g, new THREE.CylinderGeometry(0.17, 0.17, 0.45, 20), mat(c, { roughness: 0.3 }), [0, 0.3, 0]);
  add(g, new THREE.CylinderGeometry(0.13, 0.13, 0.14, 16), mat('#e0483a'), [0, 0.84, 0]);
  return g;
}
run({
  ground: '#9fa9b8', frame: { x: 0.9, y: 1.9, H: 5.2 }, el: 40,
  genie: { x: -2.1, z: 0.6, scale: 1.5, ry: 0.5, pose: { headTilt: 0.05, arms: { l: [0, 1.0, 0.5], r: [0, -0.4, 0.2] } }, mouth: 0.2 },
  build({ scene, genie }) {
    add(scene, new THREE.BoxGeometry(40, 9, 0.4), mat('#e4e9f1'), [0, 4.5, -6]);
    add(scene, new THREE.BoxGeometry(40, 1.2, 0.2), mat('#7fb8e0'), [0, 4.9, -5.75]);
    [[-0.2, 1.0, 3.0], [2.0, 0.9, 2.5], [4.0, 0.8, 2.1]].forEach(([x, r, h]) => { const t = tank(r, h); t.position.set(x, 0, -3.6); scene.add(t); });
    const gr = gear(1.0, 12); gr.position.set(-3.4, 3.4, -5.6); scene.add(gr);
    const g2 = gear(0.6, 9); g2.position.set(-1.8, 2.7, -5.6); g2.rotation.z = 0.2; scene.add(g2);
    add(scene, new THREE.BoxGeometry(5.0, 0.5, 1.1), mat('#444b5a'), [2.4, 0.4, 1.4]);
    add(scene, new THREE.BoxGeometry(5.0, 0.1, 1.2), mat('#2a2f3a'), [2.4, 0.67, 1.4]);
    for (let i = 0; i < 6; i++) add(scene, new THREE.CylinderGeometry(0.17, 0.17, 1.15, 12), mat('#8a93a3'), [0.0 + i * 0.85, 0.4, 1.4], [Math.PI / 2, 0, 0]);
    add(scene, new THREE.BoxGeometry(60, 0.02, 0.3), mat('#f7d65a'), [0, 0.012, 3.0]);
    ['#e0483a', '#3bd06a', '#2a6fd8', '#f0a020', '#c04ae0'].forEach((c, i) => { const v = vial(c); v.position.set(0.2 + i * 0.95, 0.72, 1.4); v.scale.setScalar(1.0); scene.add(v); });
    const hat = new THREE.Group();
    add(hat, new THREE.SphereGeometry(0.3, 28, 16, 0, Math.PI * 2, 0, Math.PI / 2), mat('#ffd21f', { roughness: 0.4 }), [0, 0.03, 0]);
    add(hat, new THREE.TorusGeometry(0.3, 0.035, 8, 32), mat('#ffd21f'), [0, 0.03, 0], [Math.PI / 2, 0, 0]);
    add(hat, new THREE.BoxGeometry(0.06, 0.2, 0.5), mat('#ffd21f'), [0, 0.28, 0.0]);
    genie.userData.parts.head.add(hat);
  },
});
