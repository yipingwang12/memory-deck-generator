const stage = setup('#9ac879'); const S = stage.scene;
const dark = mat('#2a2d36', { roughness: 0.5 });
const crate = new THREE.Group(); crate.position.set(1.4, 0, 0.2); S.add(crate);
box(crate, dark, [0, 0.5, 0], [1.4, 1.0, 1.0]);
for (const y of [0.2, 0.5, 0.8]) box(crate, mat('#3b3f4c'), [0, y, 0.505], [1.42, 0.06, 0.02]);
box(crate, mat('#0a0710'), [0, 1.0, 0], [1.2, 0.02, 0.8]);
for (let i = 0; i < 6; i++) blob(crate, glow('#c9a2ff', 0.9), [-0.5 + i * 0.2, 1.05 + (i % 2) * 0.1, 0], [0.05, 0.05, 0.05]);
const lid = new THREE.Group(); lid.position.set(0, 1.0, -0.5); lid.rotation.x = -0.9; crate.add(lid); box(lid, dark, [0, 0.03, 0.5], [1.46, 0.07, 1.04]);
// stealth: ninja eye-slit on the front
box(crate, mat('#f2f2f2'), [0, 0.65, 0.512], [0.9, 0.16, 0.01]); blob(crate, mat('#111'), [-0.22, 0.65, 0.518], [0.07, 0.07, 0.01]); blob(crate, mat('#111'), [0.22, 0.65, 0.518], [0.07, 0.07, 0.01]);
const nail = new THREE.Group(); nail.position.set(1.3, 1.5, 0.75); nail.rotation.z = -0.9; S.add(nail);
const steel = mat('#b9c0c8', { metalness: 0.7, roughness: 0.3 });
cyl(nail, steel, [0, 0, 0], 0.07, 0.07, 1.3); cyl(nail, steel, [0, 0.67, 0], 0.17, 0.17, 0.07); add(nail, new THREE.ConeGeometry(0.06, 0.25, 14), steel, [0, -0.77, 0], [Math.PI, 0, 0]);
const lil = LIL(stage, -1.0, 0, 0.3, 1.6, { arms: { l: [0.2, 0.8, 0], r: [0, 0.5, 0] } });
finishScene(stage, [lil], [0.3, 1.1, 5.0], [0.3, 0.9, 0]);
