const m = microscope(S, [0.55, 0, 0.5], 1.9);
m.updateMatrixWorld(true);
for (const s of [-1, 1]) { const h = bomb.worldToLocal(V([0.55 + (s < 0 ? -0.35 : 1.05), 0.75, 0.75])).toArray(); strut(bomb, chrome, [s * 0.85, 0.0, 0.1], h, 0.1); blob(bomb, chrome, h, [0.15, 0.15, 0.15]); }
finishScene(stage, [lil], [0.4, 1.15, 5.6], [0.4, 1.0, 0]);
