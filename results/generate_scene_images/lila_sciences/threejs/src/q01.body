const stage = setup('#a8763e');
const S = stage.scene, wood = mat('#6b4423');
for (let i = -8; i < 9; i++) box(S, mat(i % 2 ? '#a8763e' : '#b98648'), [i * 0.5, 0.005, 0], [0.02, 0.01, 40]);
box(S, wood, [0, 0.35, -2.4], [14, 0.7, 0.2]); for (let i = -6; i <= 6; i += 1.5) cyl(S, wood, [i, 0.5, -2.4], 0.07, 0.07, 1.0);
cyl(S, mat('#8a5a2e'), [0.3, 1.9, -2.2], 0.1, 0.12, 3.8);
box(S, mat('#d23a32'), [0.9, 3.2, -2.2], [1.2, 0.7, 0.04]); blob(S, mat('#fff'), [0.9, 3.2, -2.17], [0.17, 0.17, 0.02]);
box(S, mat('#f4efe2'), [0.3, 1.6, -2.5], [2.4, 2.0, 0.05]);
const hatch = box(S, mat('#0a0710'), [1.5, 0.012, 0.15], [1.4, 0.02, 1.0]);
for (const [x, z, w, d] of [[1.5, -0.4, 1.6, 0.12], [1.5, 0.7, 1.6, 0.12], [0.75, 0.15, 0.12, 1.1], [2.25, 0.15, 0.12, 1.1]]) box(S, wood, [x, 0.07, z], [w, 0.14, d]);
const lil = LIL(stage, -0.9, 0, 0.35, 1.6, { arms: { l: [0.2, 0.6, 0], r: [0, 0.4, 0] } });
const g = gnome({ scale: 2.3, hl: [-0.2, 0.55, 0.3], hr: [0.2, 0.55, 0.3] }); g.position.set(1.5, 0.02, -0.5); S.add(g);
seed(S, [1.5, 1.05, 0.25], 0.22);
for (let i = 0; i < 6; i++) blob(S, glow('#e9d2ff', 0.8), [1.3 + (i % 3) * 0.2, 0.7 + (i % 2) * 0.35, 0.05], [0.02, 0.02, 0.02]);
finishScene(stage, [lil], [0.3, 1.5, 5.3], [0.3, 1.0, 0]);
