const green = mat('#76b900'), dk = mat('#2a3a14'), goldp = mat('#e8c860', { metalness: 0.6, roughness: 0.3 });
box(chip, dk, [0, 1.25, 0], [1.5, 1.5, 0.2]); box(chip, green, [0, 1.25, 0.11], [1.25, 1.25, 0.04]);
box(chip, new THREE.MeshStandardMaterial({ map: textTex('NVIDIA', 512, 160, '#76b900', '#0a0a0a', 'bold 110px sans-serif') }), [0, 1.0, 0.14], [1.1, 0.34, 0.01]);
